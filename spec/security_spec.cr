require "spec"
require "../src/tune/protocol/frame"
require "../src/tune/security/keys"

describe Tune::Security do
  it "signs, verifies and rejects changed messages and signatures" do
    key = Tune::Security::Key.generate
    message = "test".to_slice
    signature = key.sign(message)
    key.verify(message, signature).should be_true
    key.verify("other".to_slice, signature).should be_false
    signature[0] ^= 1
    key.verify(message, signature).should be_false
    key.close
  end

  it "round trips OpenSSH keys with safe permissions and refuses overwrite" do
    directory = File.join(Dir.tempdir, "tune-keys-#{Random::Secure.hex(8)}")
    path = File.join(directory, "id_ed25519")
    begin
      identity = Tune::Security::Identity.generate(path)
      loaded = Tune::Security::Identity.load(path)
      loaded.fingerprint.should eq(identity.fingerprint)
      File.info(path).permissions.value.should eq(0o600)
      Tune::Security::AuthorizedKeys.new(path + ".pub").keys.has_key?(identity.fingerprint).should be_true
      expect_raises(ArgumentError) { Tune::Security::Identity.generate(path) }
      output = IO::Memory.new
      Process.run("ssh-keygen", ["-y", "-f", path], output: output).success?.should be_true
      output.to_s.split[1].should eq(File.read(path + ".pub").split[1])
    ensure
      File.delete(path) if File.exists?(path)
      File.delete(path + ".pub") if File.exists?(path + ".pub")
      Dir.delete(directory) if Dir.exists?(directory)
    end
  end

  it "rejects replay, expiry and unknown identities" do
    key = Tune::Security::Key.generate
    challenge = Tune::Security::Challenge.new("https://example.com", "id", "name")
    signature = key.sign(challenge.transcript)
    challenge.verify(key.raw, signature).should be_true
    challenge.verify(key.raw, signature).should be_false
    expired = Tune::Security::Challenge.new("https://example.com", "id", "name", -1.seconds)
    expired.verify(key.raw, key.sign(expired.transcript)).should be_false
    unknown = Tune::Security::Challenge.new("https://example.com", "id", "name")
    unknown.verify(nil, key.sign(unknown.transcript)).should be_false
    context = Tune::Security::Challenge.new("https://example.com", "id", "name")
    changed = Tune::Security::Challenge.transcript("https://other.example", "id", "name", context.nonce)
    context.verify(key.raw, key.sign(changed)).should be_false
  end

  it "reads an identity generated by OpenSSH" do
    directory = File.join(Dir.tempdir, "tune-import-#{Random::Secure.hex(8)}")
    Dir.mkdir(directory, 0o700)
    path = File.join(directory, "id")
    begin
      Process.run("ssh-keygen", ["-q", "-t", "ed25519", "-N", "", "-f", path]).success?.should be_true
      identity = Tune::Security::Identity.load(path)
      allowed = Tune::Security::AuthorizedKeys.new(path + ".pub")
      allowed.keys.has_key?(identity.fingerprint).should be_true
    ensure
      File.delete(path) if File.exists?(path)
      File.delete(path + ".pub") if File.exists?(path + ".pub")
      Dir.delete(directory)
    end
  end
end
