TUNE_DOMAIN=tune.example.com
ACME_EMAIL=admin@example.com
# Provider identifier from https://go-acme.github.io/lego/dns/
DNS_PROVIDER=cloudflare
# Set true after accepting your CA's subscriber agreement.
ACME_ACCEPT_TOS=false

# Test staging with a SEPARATE Compose project (see README).
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# If this subnet conflicts with your host networks, change all three together.
# TUNE_SUBNET=172.30.80.0/24
# VIA_IP=172.30.80.2
# TUNE_IP=172.30.80.3
